[
  {
    "id": "g1-1",
    "text": "陈默手臂上那道认不出的旧刻痕是什么字、哪一晚刻的。",
    "plantedAt": 1,
    "dueBy": 15,
    "paidAt": 8,
    "importance": 2
  },
  {
    "id": "g1-2",
    "text": "陈默记不住死者的脸，但记得“断眉”——记忆被擦除的机制。",
    "plantedAt": 1,
    "dueBy": 12,
    "paidAt": null,
    "importance": 2
  },
  {
    "id": "g2-1",
    "text": "陈默次日见到眉毛完整的灰夹克，与昨晚断眉的周成对不上，他记不清哪里不对——断眉与完整眉的矛盾待解。",
    "plantedAt": 2,
    "dueBy": 10,
    "paidAt": 8,
    "importance": 2
  },
  {
    "id": "g3-1",
    "text": "三层皮带柜台台面那道旧浅沟不是陈默刻的，但收笔与他手臂第三道刻痕一模一样，刻沟的人是谁待解。",
    "plantedAt": 3,
    "dueBy": 15,
    "paidAt": 12,
    "importance": 2
  },
  {
    "id": "g3-2",
    "text": "柜台底板木纹倒刺上缠着一根黑色长发，不是陈默的，他没碰，后来解下绕指又弹回原处。",
    "plantedAt": 3,
    "dueBy": 12,
    "paidAt": 12,
    "importance": 1
  },
  {
    "id": "g4-1",
    "text": "B2第七根柱子背后那双整齐摆放、鞋底沾红的男式皮鞋是谁的，为什么鞋里没有人。",
    "plantedAt": 4,
    "dueBy": 12,
    "paidAt": 12,
    "importance": 2
  },
  {
    "id": "g4-2",
    "text": "林雨记得第一夜有十四个人却只能叫出十三个名字，多出的那个她记不起脸——那个被遗忘的人是谁。",
    "plantedAt": 4,
    "dueBy": 12,
    "paidAt": 12,
    "importance": 2
  },
  {
    "id": "g5-1",
    "text": "陈默左臂“赵”字刻痕是他自己笔迹，但掌心无刻字痕迹——刻这个字的不是他的手，是谁刻的、何时刻的。",
    "plantedAt": 5,
    "dueBy": 10,
    "paidAt": 10,
    "importance": 3
  },
  {
    "id": "g5-2",
    "text": "小王便签上“问的不是赵”四字是陈默自己写的，他却记不清是谁问的——那个被遗忘的提问者是谁。",
    "plantedAt": 5,
    "dueBy": 10,
    "paidAt": 9,
    "importance": 2
  },
  {
    "id": "g6-1",
    "text": "小王本子上那页不是他笔迹的“林雨”两种写法，第二字被水泡花，是谁写的、写的什么。",
    "plantedAt": 6,
    "dueBy": 12,
    "paidAt": 12,
    "importance": 2
  },
  {
    "id": "g6-2",
    "text": "陈默与林雨约定当天五点在三层皮带柜台交换各自丢失的信息，届时会发生什么。",
    "plantedAt": 6,
    "dueBy": 10,
    "paidAt": 9,
    "importance": 2
  },
  {
    "id": "g7-1",
    "text": "老周断臂指缝里夹着小王的牙签，牙签上沾血和墨，小王与老周之死的关系待解。",
    "plantedAt": 7,
    "dueBy": 13,
    "paidAt": null,
    "importance": 2
  },
  {
    "id": "g7-2",
    "text": "B2货梯里顶着老周脸的人（此前是陈默的脸）进了货梯，楼层显示停在B2不动，货梯里是什么待解。",
    "plantedAt": 7,
    "dueBy": 13,
    "paidAt": null,
    "importance": 2
  },
  {
    "id": "g8-1",
    "text": "老周被问“周正”时喉咙卡住，只能说出半句“周正不是别人，是刻字那个人自己忘掉的”，后半句被声带合上——老周喉中的“塞子”是什么、谁下的、完整的话是什么。",
    "plantedAt": 8,
    "dueBy": 13,
    "paidAt": null,
    "importance": 3
  },
  {
    "id": "g8-2",
    "text": "笔记本文件夹“漏洞宿主”下写着“周正”，陈默手臂上露出半个“正”字——这个文件夹是谁建的、里面还有什么内容。",
    "plantedAt": 8,
    "dueBy": 13,
    "paidAt": null,
    "importance": 3
  },
  {
    "id": "g9-1",
    "text": "U盘日志中三年前暴雨夜“修订记录”被折叠，点开是空白，有人删过内容留了壳——被删的内容是什么。",
    "plantedAt": 9,
    "dueBy": 14,
    "paidAt": null,
    "importance": 2
  },
  {
    "id": "g9-2",
    "text": "林雨第一夜写“别信陈默”便条的原因未解释，她为何在第一夜就写下这四个字。",
    "plantedAt": 9,
    "dueBy": 12,
    "paidAt": 12,
    "importance": 2
  },
  {
    "id": "g10-1",
    "text": "那半句规则下面的手写落款收笔往上挑一个钩，与陈默左臂刻痕相同——落款是谁写的，是否与刻“赵”字的是同一人。",
    "plantedAt": 10,
    "dueBy": 15,
    "paidAt": null,
    "importance": 2
  },
  {
    "id": "g10-2",
    "text": "陈默无法说清“自愿”的含义，他记不起自己何时自愿、对谁自愿——若落款钩与他是同一只手，“自愿”从一开始就不在他嘴里。",
    "plantedAt": 10,
    "dueBy": 14,
    "paidAt": null,
    "importance": 2
  },
  {
    "id": "g11-1",
    "text": "陈默臂上“杀漏洞”三字底下的日期空着，他必须弄清“三天”从哪天算起。",
    "plantedAt": 11,
    "dueBy": 13,
    "paidAt": null,
    "importance": 3
  },
  {
    "id": "g11-2",
    "text": "红外套孩子模仿陈默在皮带柜台照玻璃的样子看了他一眼，它为何能学陈默的举止待解。",
    "plantedAt": 11,
    "dueBy": 15,
    "paidAt": null,
    "importance": 2
  },
  {
    "id": "g12-1",
    "text": "陈默对林雨说出的她女儿的名字，是从他左臂“雨”字下旧痂按出来的；林雨被刺后记得这个名字却想不起是谁告诉她的——这个名字的来源与记忆擦除机制待解。",
    "plantedAt": 12,
    "dueBy": 16,
    "paidAt": null,
    "importance": 2
  },
  {
    "id": "g12-2",
    "text": "顶着王脸的人能叫出众人名字却拒答自己名字，且右肩低、摸红绳金属壳弹响——它是否也丢失了自己的名字、壳里是什么待解。",
    "plantedAt": 12,
    "dueBy": 15,
    "paidAt": null,
    "importance": 2
  }
]
